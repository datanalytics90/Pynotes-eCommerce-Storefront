# Copy this file to .env and fill in real values. Never commit the real .env file.

# --- Core Django ---
# Generate one with: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Asia/Kolkata

# --- Database ---
# Local dev falls back to SQLite automatically if DATABASE_URL is unset.
# Production example (Postgres): postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=

# --- Site ---
SITE_NAME=PyNotes
SITE_DOMAIN=localhost:8000

# --- CORS (comma separated, only needed if a separate frontend calls the API) ---
CORS_ALLOWED_ORIGINS=

# --- Email (defaults to console backend in dev) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=PyNotes <no-reply@pynotes.store>

# --- Razorpay (prepaid payments) ---
# Leave blank to run prepaid checkout in "demo mode" (orders are marked paid immediately, no
# real payment gateway involved). Cash on Delivery always works regardless of these keys.
# Get test keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Production-only (config.settings.prod) ---
SECURE_SSL_REDIRECT=True
CSRF_TRUSTED_ORIGINS=https://yourdomain.com

# Business settings (GSTIN, COD fee, prepaid discount %, announcement bar, etc.) are NOT
# environment variables — they are edited by an Administrator from Django admin under
# "Site settings", "Announcement messages", "Testimonials", "FAQs" and "Legal pages".
