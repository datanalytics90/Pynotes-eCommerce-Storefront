# Copy this file to .env and fill in real values. Never commit the real .env file.

# --- Core Django ---
# Generate one with: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=UTC

# --- Database ---
# Local dev falls back to SQLite automatically if DATABASE_URL is unset.
# Production example (Postgres): postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=

# --- Site ---
SITE_NAME=Pynotes Store
SITE_DOMAIN=localhost:8000

# --- CORS (comma separated, only needed if a separate frontend calls the API) ---
CORS_ALLOWED_ORIGINS=

# --- Email (defaults to console backend in dev) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Pynotes Store <no-reply@pynotes.store>

# --- Stripe ---
# Leave blank to run checkout in "demo mode" (orders are marked paid immediately, no real payment).
# Get test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CURRENCY=usd

# --- Production-only (config.settings.prod) ---
SECURE_SSL_REDIRECT=True
CSRF_TRUSTED_ORIGINS=https://yourdomain.com
